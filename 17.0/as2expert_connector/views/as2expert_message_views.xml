<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_as2expert_message_tree" model="ir.ui.view">
        <field name="name">as2expert.message.tree</field>
        <field name="model">as2expert.message</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'failed'" decoration-muted="state == 'draft'">
                <field name="create_date"/>
                <field name="direction" widget="badge"
                       decoration-primary="direction == 'outbound'"
                       decoration-info="direction == 'inbound'"/>
                <field name="partner_id"/>
                <field name="subject"/>
                <field name="filename"/>
                <field name="message_ref"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent' or state == 'received'"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state == 'draft'"/>
                <field name="account_id"/>
            </tree>
        </field>
    </record>

    <record id="view_as2expert_message_form" model="ir.ui.view">
        <field name="name">as2expert.message.form</field>
        <field name="model">as2expert.message</field>
        <field name="arch" type="xml">
            <form class="o_as2expert_form">
                <header>
                    <button name="action_send" type="object" string="Send over AS2"
                            class="btn-primary"
                            invisible="direction != 'outbound' or state == 'sent'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,received"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="direction"/>
                            <field name="partner_id"
                                   invisible="direction != 'outbound'"
                                   required="direction == 'outbound'"/>
                            <field name="subject"/>
                        </group>
                        <group>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="message_ref"/>
                            <field name="message_id_api" invisible="direction != 'inbound'"/>
                            <field name="sent_at" invisible="direction != 'outbound'"/>
                            <field name="received_at" invisible="direction != 'inbound'"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error">
                        <field name="error" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_as2expert_message_search" model="ir.ui.view">
        <field name="name">as2expert.message.search</field>
        <field name="model">as2expert.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="message_ref"/>
                <filter name="outbound" string="Outbound" domain="[('direction','=','outbound')]"/>
                <filter name="inbound" string="Inbound" domain="[('direction','=','inbound')]"/>
                <separator/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_direction" string="Direction" context="{'group_by':'direction'}"/>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="g_partner" string="Partner" context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_as2expert_message" model="ir.actions.act_window">
        <field name="name">AS2 Messages</field>
        <field name="res_model">as2expert.message</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_direction': 'outbound'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Send your first AS2 message</p>
            <p>Attach a file, pick a partner, and send it over AS2 through AS2Expert.
               Received messages appear here automatically.</p>
        </field>
    </record>
</odoo>
